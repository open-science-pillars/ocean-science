  "published_uncertainty": {
   "product_statement": "The NASA-SSH V1.1 User Guide publishes no uncertainty for the gridded fields. For the along-track source it states that the orbit error reduction lowers the RMS variability of crossovers by a variance of about 2.3 cm, and that a pass is removed when its crossover mean exceeds 0.1 m or its crossover RMS exceeds 0.27 m; the gridded ssha is a 100 km Gaussian-weighted average of ten days of those passes, produced every seven days, so adjacent grids share data.",
   "product_statement_source": "https://archive.podaac.earthdata.nasa.gov/podaac-ops-cumulus-docs/web-misc/nasa-ssh/NASA-SSH_V1_1_UserGuide.pdf",
   "regional_trend_uncertainty_mm_yr": 0.83,
